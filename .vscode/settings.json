{
	"cSpell.words": [],
	"editor.codeActionsOnSave": {
		"source.fixAll": "explicit",
		"source.fixAll.biome": "explicit",
		"source.organizeImports.biome": "never"
	},
	"editor.formatOnSave": true,
	"editor.defaultFormatter": "biomejs.biome",
	"[javascript]": {
		"editor.defaultFormatter": "biomejs.biome"
	},
	"[typescript]": {
		"editor.defaultFormatter": "biomejs.biome"
	},
	"[json]": {
		"editor.defaultFormatter": "biomejs.biome"
	},
	"[jsx]": {
		"editor.defaultFormatter": "biomejs.biome"
	},
	"[tsx]": {
		"editor.defaultFormatter": "biomejs.biome"
	},
	"[markdown]": {
		"editor.defaultFormatter": "biomejs.biome"
	},
	"[typescriptreact]": {
		"editor.defaultFormatter": "biomejs.biome"
	}
}
