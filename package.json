{
	"name": "yt-downloader",
	"version": "2.3.0",
	"description": "YouTube Downloader Application",
	"author": "Arpit Dalal <arpitdalalm@gmail.com>",
	"private": true,
	"type": "module",
	"engines": {
		"node": ">=22.13.0",
		"pnpm": ">=11.3.0"
	},
	"scripts": {
		"dev": "vite",
		"dev:renderer": "vite",
		"tauri:dev": "tauri dev",
		"test": "pnpm test:rust && pnpm test:python && pnpm test:frontend",
		"test:rust": "cd src-tauri && cargo test",
		"test:python": "python -m pytest python/test_downloader.py",
		"test:frontend": "vitest run app/lib/*.test.ts",
		"test:python:realworld": "cross-env RUN_REAL_WORLD_TESTS=1 python -m pytest python/test_downloader_real_world.py -s",
		"build": "vite build",
		"tauri:build": "tauri build",
		"tauri:build:mac": "tauri build --target aarch64-apple-darwin",
		"tauri:build:win": "tauri build --target x86_64-pc-windows-msvc",
		"tauri:build:linux": "tauri build --target x86_64-unknown-linux-gnu",
		"prebuild": "node scripts/prebuild.js",
		"typecheck": "tsc",
		"python:install": "pip install -r python/requirements.txt",
		"python:typecheck": "mypy python/",
		"lint": "run-p lint:ts lint:python lint:rust lint:shell",
		"lint:ts": "biome check app/ vite.config.ts scripts/prebuild.js",
		"lint:python": "ruff check python/ && ruff format --check python/",
		"lint:rust": "cargo clippy --manifest-path src-tauri/Cargo.toml -- -D warnings",
		"lint:shell": "shellcheck scripts/*.sh",
		"format": "run-p format:ts format:python format:rust",
		"format:ts": "biome check --write app/ vite.config.ts scripts/prebuild.js",
		"format:python": "ruff format python/ && ruff check --fix python/",
		"format:rust": "cargo fmt --manifest-path src-tauri/Cargo.toml",
		"prepare": "lefthook install",
		"release:check-version": "node scripts/check-release-version.mjs",
		"release:check-pushed-tags": "node scripts/check-pushed-tags.mjs"
	},
	"dependencies": {
		"@tauri-apps/api": "^2.11.0",
		"@tauri-apps/plugin-dialog": "^2.7.1",
		"@tauri-apps/plugin-log": "^2.8.0",
		"react": "^19.2.6",
		"react-dom": "^19.2.6"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.4.15",
		"@tailwindcss/vite": "^4.3.0",
		"@tauri-apps/cli": "^2.11.2",
		"@types/node": "^22.19.19",
		"@types/react": "^19.2.15",
		"@types/react-dom": "^19.2.3",
		"@vitejs/plugin-react": "^4.3.4",
		"cross-env": "^10.1.0",
		"lefthook": "^2.1.8",
		"npm-run-all2": "^8.0.4",
		"tailwindcss": "^4.3.0",
		"typescript": "^5.9.3",
		"vite": "^6.4.2",
		"vite-tsconfig-paths": "^5.1.4",
		"vitest": "^4.1.7"
	},
	"packageManager": "pnpm@11.3.0+sha512.2c403d6594527287672b1f7056343a1f7c3634036a67ffabfcc2b3d7595d843768f8787148d1b57cf7956c90606bbd192857c363af19e96d2d0ec9ec5741d215"
}
