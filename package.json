{
	"name": "yt-downloader",
	"version": "2.4.0",
	"description": "YouTube Downloader Application",
	"author": "Arpit Dalal <arpitdalalm@gmail.com>",
	"private": true,
	"type": "module",
	"engines": {
		"node": ">=26.0.0",
		"pnpm": "11.21.0"
	},
	"scripts": {
		"dev": "vite",
		"dev:renderer": "vite",
		"tauri:dev": "tauri dev",
		"test": "pnpm test:rust && pnpm test:python && pnpm test:frontend && pnpm test:scripts",
		"test:rust": "cd src-tauri && cargo test",
		"test:python": "python3 -m pytest python/test_downloader.py",
		"test:frontend": "vitest run app/lib/*.test.ts",
		"test:scripts": "node --test scripts/*.test.mjs",
		"test:python:realworld": "cross-env RUN_REAL_WORLD_TESTS=1 python3 -m pytest python/test_downloader_real_world.py -s",
		"build": "vite build",
		"tauri:build": "tauri build",
		"tauri:build:mac": "tauri build --target aarch64-apple-darwin",
		"tauri:build:win": "tauri build --target x86_64-pc-windows-msvc",
		"tauri:build:linux": "tauri build --target x86_64-unknown-linux-gnu",
		"prebuild": "node scripts/prebuild.js",
		"typecheck": "tsc",
		"python:install": "pip install -r python/requirements.txt",
		"python:typecheck": "mypy python/",
		"lint": "run-p lint:ts lint:python lint:rust lint:shell",
		"lint:ts": "biome check app/ vite.config.ts scripts/prebuild.js scripts/generate-updater-manifest.mjs scripts/generate-updater-manifest.test.mjs",
		"lint:python": "ruff check python/ && ruff format --check python/",
		"lint:rust": "cargo clippy --manifest-path src-tauri/Cargo.toml -- -D warnings",
		"lint:shell": "shellcheck scripts/*.sh",
		"format": "run-p format:ts format:python format:rust",
		"format:ts": "biome check --write app/ vite.config.ts scripts/prebuild.js scripts/generate-updater-manifest.mjs scripts/generate-updater-manifest.test.mjs",
		"format:python": "ruff format python/ && ruff check --fix python/",
		"format:rust": "cargo fmt --manifest-path src-tauri/Cargo.toml",
		"prepare": "lefthook install",
		"release:check-version": "node scripts/check-release-version.mjs",
		"release:check-pushed-tags": "node scripts/check-pushed-tags.mjs"
	},
	"dependencies": {
		"@tauri-apps/api": "^2.11.1",
		"@tauri-apps/plugin-dialog": "^2.7.2",
		"@tauri-apps/plugin-log": "^2.9.0",
		"@tauri-apps/plugin-process": "^2.3.1",
		"@tauri-apps/plugin-updater": "^2.10.1",
		"react": "^19.2.8",
		"react-dom": "^19.2.8"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.8",
		"@tailwindcss/vite": "^4.3.3",
		"@tauri-apps/cli": "^2.11.4",
		"@types/node": "^26.2.0",
		"@types/react": "^19.2.18",
		"@types/react-dom": "^19.2.4",
		"@vitejs/plugin-react": "^4.7.0",
		"cross-env": "^10.1.0",
		"lefthook": "^2.1.10",
		"npm-run-all2": "^9.0.3",
		"tailwindcss": "^4.3.3",
		"typescript": "^5.9.3",
		"vite": "^6.4.3",
		"vite-tsconfig-paths": "^5.1.4",
		"vitest": "^4.1.10"
	},
	"packageManager": "pnpm@11.21.0+sha512.521705bce689924eac72f5a3587122f362689ef6571e55ba80076fd637c11132ecffada26fad4ea79c485bfddbfd3d5a2a5b05805a77e893de71ec8a6cca3bb1"
}
