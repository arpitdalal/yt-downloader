{
	"$schema": "../gen/schemas/desktop-schema.json",
	"identifier": "default",
	"description": "enables the default permissions",
	"windows": ["main"],
	"permissions": [
		"core:default",
		"dialog:default",
		"log:default",
		{
			"identifier": "opener:allow-open-url",
			"allow": [{ "url": "https://arpit.im/*" }]
		},
		"process:allow-restart",
		"updater:default"
	]
}
