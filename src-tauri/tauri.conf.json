{
	"$schema": "https://schema.tauri.app/config/2",
	"productName": "YouTube Downloader",
	"version": "2.4.1",
	"identifier": "com.ytdownloader.app",
	"build": {
		"frontendDist": "../dist",
		"devUrl": "http://localhost:5173",
		"beforeDevCommand": "pnpm dev:renderer",
		"beforeBuildCommand": "pnpm build"
	},
	"app": {
		"windows": [
			{
				"title": "YouTube Downloader",
				"width": 1200,
				"height": 800,
				"resizable": true,
				"fullscreen": false
			}
		],
		"security": {
			"csp": "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; connect-src 'self' http://localhost:5173 ws://localhost:5173;"
		}
	},
	"bundle": {
		"active": true,
		"createUpdaterArtifacts": true,
		"targets": ["dmg", "nsis", "appimage", "deb", "rpm"],
		"category": "Utility",
		"shortDescription": "Download videos and audio from supported platforms.",
		"longDescription": "YouTube Downloader is a desktop utility to fetch video and audio streams using a bundled Python runtime and FFmpeg, without requiring system Python or FFmpeg installs.",
		"linux": {
			"appimage": {
				"files": {
					"/usr/share/metainfo/com.ytdownloader.app.metainfo.xml": "linux/com.ytdownloader.app.metainfo.xml"
				}
			},
			"deb": {
				"files": {
					"/usr/share/metainfo/com.ytdownloader.app.metainfo.xml": "linux/com.ytdownloader.app.metainfo.xml"
				}
			},
			"rpm": {
				"files": {
					"/usr/share/metainfo/com.ytdownloader.app.metainfo.xml": "linux/com.ytdownloader.app.metainfo.xml"
				}
			}
		},
		"resources": {
			"resources/python": "python",
			"resources/ffmpeg": "ffmpeg",
			"resources/jsruntime": "jsruntime"
		},
		"icon": [
			"../build/icons/icon.png",
			"../build/icons/icon_512x512.png",
			"../build/icons/icon.icns",
			"../build/icons/icon.ico"
		]
	},
	"plugins": {
		"updater": {
			"pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDk2QzVFN0IzQkM1NTIyRDgKUldUWUlsVzhzK2ZGbHJhZXVsYm1IWFpyYTdHZjZvVUw2d0RJM3ZoeUxMK3hMcTZHZlduYTIrWkwK",
			"endpoints": [
				"https://github.com/arpitdalal/yt-downloader/releases/latest/download/latest.json"
			],
			"windows": {
				"installMode": "passive"
			}
		}
	}
}
