---
const features = [
  {
    title: "YouTube download",
    description: "Fetch video or audio with quality options. Uses browser cookies for signed-in content.",
  },
  {
    title: "Local file processing",
    description: "Cut sections and concatenate local videos without re-encoding when possible.",
  },
  {
    title: "Cross-platform",
    description: "macOS (Apple Silicon), Windows, and Linux. Single installable per OS.",
  },
  {
    title: "Self-contained",
    description: "Bundles Python, yt-dlp, and FFmpeg. No system dependencies required.",
  },
];
---

<section class="border-y border-[var(--color-border)] bg-[var(--color-surface)]/60 px-6 py-24 sm:py-28">
  <div class="mx-auto max-w-5xl">
    <h2 class="scroll-in font-display text-center text-2xl font-bold tracking-tight text-[#fafafa] sm:text-3xl">
      Features
    </h2>
    <ul class="mt-14 grid gap-5 sm:grid-cols-2 sm:gap-6">
      {features.map((f, i) => (
        <li class="scroll-in rounded-2xl border border-[var(--color-border)] bg-[var(--color-surface-elevated)]/80 p-6 backdrop-blur-sm transition hover:border-white/10 hover:bg-[var(--color-surface-elevated)] sm:p-7">
          <h3 class="font-display font-semibold text-[var(--color-accent)]">{f.title}</h3>
          <p class="mt-2 text-[15px] leading-relaxed text-[var(--color-muted)]">{f.description}</p>
        </li>
      ))}
    </ul>
  </div>
</section>
