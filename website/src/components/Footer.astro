---
interface Release {
  tag: string;
  version: string;
}
interface Props {
  release: Release;
}
const { release } = Astro.props;
---

<footer class="border-t border-zinc-800 px-6 py-8">
  <div class="mx-auto flex max-w-3xl flex-wrap items-center justify-between gap-4 text-sm text-zinc-500">
    <span>v{release.version}</span>
    <a href="https://github.com/arpitdalal/yt-downloader" class="text-amber-400/90 hover:underline">GitHub</a>
    <span>MIT License</span>
  </div>
</footer>
