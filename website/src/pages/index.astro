---
import Layout from "../layouts/Layout.astro";
import Hero from "../components/Hero.astro";
import Features from "../components/Features.astro";
import Downloads from "../components/Downloads.astro";
import Footer from "../components/Footer.astro";
import { getReleaseData } from "../lib/github";
const release = await getReleaseData();
---

<Layout title="YouTube Downloader" description="Desktop app for downloading YouTube videos and processing local files. macOS, Windows, Linux.">
  <main>
    <Hero release={release} />
    <Features />
    <Downloads release={release} />
    <Footer release={release} />
  </main>
</Layout>
